# ==========================================
# Application Configuration
# ==========================================
PORT=10000
NODE_ENV=production

# ==========================================
# Security Settings
# ==========================================
# Generate a highly secure random string for JWT tokens (e.g., openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# ==========================================
# Database Configuration
# ==========================================
# Production MongoDB connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mmm_db?retryWrites=true&w=majority

# ==========================================
# CORS Settings
# ==========================================
# Match this with your client production URL (exclude trailing slash)
CORS_ORIGIN=https://mmm-web-app.onrender.com